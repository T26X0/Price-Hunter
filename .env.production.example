# Скопируйте файл в .env.production только на production-сервере.
# Не коммитьте реальный файл и не пересылайте токены в чат.

POSTGRES_DB=price_hunter
POSTGRES_USER=price_hunter
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Закрывает /api/admin/** на самом backend. Не отправляйте значение в чат или Git.
ADMIN_API_TOKEN=replace-with-a-separate-long-random-token

# Укажите только настоящие origins frontend: без путей, с https.
CORS_ALLOWED_ORIGINS=https://pricehunter.space,https://www.pricehunter.space

# Создаётся в Cloudflare Dashboard для туннеля. Не добавляйте значение в Git.
CLOUDFLARE_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Включайте планировщик только после настройки источников в production-базе.
PARSER_SCHEDULING_ENABLED=false
PARSER_POLL_CRON=0 15 * * * *
